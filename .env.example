# Local Database Connection Settings (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password_here
DB_NAME=trial_club

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-replace-in-production-random-bytes

# Cloud SQL Connection (Used only in production / Cloud Run)
# INSTANCE_CONNECTION_NAME=project-id:region:instance-id
# DB_SOCKET_DIR=/cloudsql
